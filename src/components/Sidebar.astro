---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconX from "@/assets/icons/IconX.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Avatar from "@/components/Avatar.astro";
import Socials from "@/components/Socials.astro";
import LangSwitcher from "@/components/LangSwitcher.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getPostsByLocale } from "@/utils/postLocale";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import { getIsActivePath } from "@/utils/isActivePath";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isActive = getIsActivePath(Astro.url.pathname, locale);

const posts = getPostsByLocale(
  await getCollection("posts", ({ data }) => !data.draft),
  locale
);
const tags = getUniqueTags(posts);

const countsByTag = new Map<string, number>();
for (const post of posts.filter(postFilter)) {
  for (const tag of post.data.tags) {
    const slug = slugifyStr(tag);
    countsByTag.set(slug, (countsByTag.get(slug) ?? 0) + 1);
  }
}
const categories = tags.map(({ tag, tagName }) => ({
  tag,
  tagName,
  count: countsByTag.get(tag) ?? 0,
}));
---

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"
  data-sidebar-backdrop
>
</div>
<aside
  id="sidebar"
  aria-label={site.title}
  class="border-border bg-background fixed inset-y-0 start-0 z-40 w-72 max-w-[80%] -translate-x-full overflow-y-auto border-e p-6 transition-transform duration-200 ease-out lg:sticky lg:top-24 lg:z-0 lg:h-fit lg:w-56 lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:border-e-0 lg:p-0 lg:transition-none"
>
  <div class="mb-6 flex items-center justify-end lg:hidden">
    <button
      id="sidebar-close"
      class="focus-outline p-2"
      aria-label={t.a11y.closeSidebar}
    >
      <IconX />
    </button>
  </div>

  <div class="flex flex-col items-center gap-3 text-center">
    <Avatar alt={site.author} />
    <div>
      <p class="font-semibold">{site.author}</p>
      <p class="text-muted-foreground mt-1 text-sm">{t.sidebar.bio}</p>
    </div>
    <Socials />
  </div>

  <nav aria-label={t.sidebar.navigation} class="border-border mt-8 border-t pt-6 lg:hidden">
    <ul class="flex flex-col text-sm font-medium">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class:list={[
            "hover:text-accent -ms-2 block rounded px-2 py-1.5",
            { "active-nav": isActive("/posts") },
          ]}
        >
          {t.nav.posts}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "tags")}
          class:list={[
            "hover:text-accent -ms-2 block rounded px-2 py-1.5",
            { "active-nav": isActive("/tags") },
          ]}
        >
          {t.nav.tags}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class:list={[
            "hover:text-accent -ms-2 block rounded px-2 py-1.5",
            { "active-nav": isActive("/about") },
          ]}
        >
          {t.nav.about}
        </a>
      </li>
      {
        features.showArchives && (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "archives")}
              class:list={[
                "hover:text-accent -ms-2 flex items-center gap-2 rounded px-2 py-1.5",
                { "active-nav": isActive("/archives") },
              ]}
            >
              <IconArchive class="size-4" />
              {t.nav.archives}
            </a>
          </li>
        )
      }
      {
        features.search !== false && (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, "search")}
              class:list={[
                "hover:text-accent -ms-2 flex items-center gap-2 rounded px-2 py-1.5",
                { "active-nav": isActive("/search") },
              ]}
            >
              <IconSearch class="size-4" />
              {t.nav.search}
            </a>
          </li>
        )
      }
    </ul>
  </nav>

  {
    categories.length > 0 && (
      <nav
        aria-label={t.sidebar.categories}
        class="border-border mt-8 border-t pt-6"
      >
        <h2 class="text-muted-foreground mb-3 text-sm font-semibold tracking-wide uppercase">
          {t.sidebar.categories}
        </h2>
        <ul class="flex flex-col">
          {categories.map(({ tag, tagName, count }) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
                class="hover:text-accent -ms-2 flex items-center justify-between gap-2 rounded px-2 py-1.5 text-sm"
              >
                <span class="truncate">{tagName}</span>
                <span class="text-muted-foreground shrink-0">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="border-border mt-8 flex items-center justify-between border-t pt-6 lg:hidden">
    <LangSwitcher />
    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn-mobile"
          class="theme-toggle focus-outline hover:[&>svg]:stroke-accent relative size-8"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )
    }
  </div>

  <div class="border-border mt-8 border-t pt-6">
    <a
      href="/styleguide"
      class="hover:text-accent text-muted-foreground text-xs"
    >
      Style Guide
    </a>
  </div>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.querySelector<HTMLElement>("#sidebar");
    const backdrop = document.querySelector<HTMLElement>("#sidebar-backdrop");
    const openBtn =
      document.querySelector<HTMLButtonElement>("#sidebar-toggle");
    const closeBtn =
      document.querySelector<HTMLButtonElement>("#sidebar-close");

    if (!sidebar || !backdrop || !openBtn) return;

    const openLabel = openBtn.dataset.labelOpen ?? "Open sidebar";
    const closeLabel = openBtn.dataset.labelClose ?? "Close sidebar";

    // A page navigation while the drawer was open swaps <body> but Astro's
    // ClientRouter keeps <html> around, so a stale lock could persist.
    document.documentElement.classList.remove("overflow-hidden");

    const open = () => {
      sidebar.classList.remove("-translate-x-full");
      backdrop.classList.remove("hidden");
      document.documentElement.classList.add("overflow-hidden");
      openBtn.setAttribute("aria-expanded", "true");
      openBtn.setAttribute("aria-label", closeLabel);
      closeBtn?.focus();
    };

    const close = () => {
      sidebar.classList.add("-translate-x-full");
      backdrop.classList.add("hidden");
      document.documentElement.classList.remove("overflow-hidden");
      openBtn.setAttribute("aria-expanded", "false");
      openBtn.setAttribute("aria-label", openLabel);
      openBtn.focus();
    };

    openBtn.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") close();
    });
  }

  initSidebar();
  document.addEventListener("astro:after-swap", initSidebar);
</script>
