---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import LinkButton from "./LinkButton.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { getIsActivePath } from "@/utils/isActivePath";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isActive = getIsActivePath(Astro.url.pathname, locale);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="flex w-full flex-col items-center justify-between lg:flex-row">
  <div
    class="border-border bg-background flex w-full items-center justify-between border-b py-4 lg:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="py-1 text-xl leading-8 font-semibold whitespace-nowrap lg:text-2xl lg:leading-none"
    >
      {site.title}
    </a>
    <nav id="nav-menu" class="flex items-center lg:ms-2">
      <ul
        id="nav-links"
        class="[&>li>a]:hover:text-accent [&>li]:h-8 hidden items-center gap-x-5 lg:flex [&>li>a]:block [&>li>a]:px-2 [&>li>a]:py-1 [&>li>a]:font-medium"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={{ "active-nav": isActive("/tags") }}
          >
            {t.nav.tags}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline relative size-8",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li>
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-8"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        <li>
          <LangSwitcher />
        </li>
        {
          features.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                class="theme-toggle focus-outline hover:[&>svg]:stroke-accent relative size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
      <button
        id="sidebar-toggle"
        class="focus-outline p-2 lg:hidden"
        aria-label={t.a11y.openSidebar}
        aria-expanded="false"
        aria-controls="sidebar"
        data-label-open={t.a11y.openSidebar}
        data-label-close={t.a11y.closeSidebar}
      >
        <IconMenuDeep />
      </button>
    </nav>
  </div>
</header>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
