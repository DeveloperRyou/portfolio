---
/**
 * Static lead-in for the About page: avatar + author name. Locale-agnostic
 * (no text of its own beyond the author name), so it's shared across every
 * locale's about.astro instead of being copy-pasted per locale.
 */
import Avatar from "@/components/Avatar.astro";
import config from "@/config";

const { site } = config;
---

<div class="about-hero flex flex-col items-center gap-3 pb-2">
  <Avatar alt={site.author} size="lg" class="!size-28 shadow-lg sm:!size-32" />
  <p class="text-foreground text-lg font-semibold">{site.author}</p>
</div>
