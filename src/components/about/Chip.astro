---
/**
 * Small inline label badge (e.g. "Company" / "Project") shown next to a
 * Timeline entry's org name. `tone` picks a fixed color per category (see
 * the `--chip-*` tokens in `src/styles/theme.css`, sourced from Radix
 * Colors) so the two are easy to tell apart and stay legible against both
 * this site's light and dark backgrounds. Independent of the `label` text
 * itself, which is locale-specific content from the caller.
 */
type Props = {
  label: string;
  tone?: "blue" | "brown";
  class?: string;
};

const { label, tone = "blue", class: className } = Astro.props;

const toneClasses = {
  blue: "bg-chip-blue text-chip-blue-foreground",
  brown: "bg-chip-brown text-chip-brown-foreground",
};
---

<!--
  min-w (in em, so it scales with the chip's font size) fits the longest
  current label, "Company": Inter is proportional, so same-length labels
  otherwise render at different widths and the Timeline's chips stop
  lining up.
-->
<span
  class:list={[
    "inline-block min-w-[6.5em] rounded-sm px-1.5 py-0.5 text-center align-middle text-[0.6875rem] leading-[1.25] font-medium tracking-wide uppercase",
    // Trim the font's built-in ascent/descent space down to the caps, so
    // symmetric padding centers the label exactly (without it the caps sit
    // ~1px high). Older browsers keep the untrimmed box above.
    "supports-[text-box:trim-both_cap_alphabetic]:py-[5px] supports-[text-box:trim-both_cap_alphabetic]:[text-box:trim-both_cap_alphabetic]",
    toneClasses[tone],
    className,
  ]}
>
  {label}
</span>
