---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tagName: string;
  size?: "sm" | "lg";
};

// Keyword chip only: navigation goes through the topic tree, so tags
// don't link anywhere.
const { tagName, size = "lg" } = Astro.props;
---

<li
  class:list={[
    "text-muted-foreground flex items-center gap-0.5",
    { "text-sm": size === "sm" },
    { "text-lg": size === "lg" },
  ]}
>
  <IconHash
    class:list={[
      "opacity-80",
      { "size-5": size === "lg" },
      { "size-4": size === "sm" },
    ]}
  />
  {tagName}
</li>
