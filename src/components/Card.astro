---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, coverImage, tags, ...props } = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class="my-6 flex gap-4 lg:gap-5">
  {
    coverImage && (
      <a href={postUrl} tabindex="-1" aria-hidden="true" class="shrink-0">
        <img
          src={coverImage}
          alt=""
          loading="lazy"
          width={192}
          height={112}
          class="border-border h-24 w-32 rounded-md border object-cover lg:h-28 lg:w-48"
        />
      </a>
    )
  }
  <div class="min-w-0 flex-1">
    <div
      class="flex flex-col gap-x-3 lg:flex-row lg:items-baseline lg:justify-between"
    >
      <a
        href={postUrl}
        class:list={[
          "text-accent block min-w-0 text-lg font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)} class="lg:truncate">
          {title}
        </Heading>
      </a>
      <Datetime {...props} class="shrink-0" />
    </div>
    <p class="mt-1 line-clamp-2">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-2 hidden flex-wrap gap-x-3 gap-y-1 lg:flex">
          {tags.map(tag => (
            <Tag tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }
  </div>
</li>
