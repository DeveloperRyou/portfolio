---
import type { HTMLAttributes } from "astro/types";
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
  /** Extra attributes for the `<li>`, e.g. `PostList`'s sort ranks. */
  itemAttrs?: HTMLAttributes<"li">;
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", itemAttrs, id, data, filePath } = Astro.props;

const { title, description, coverImage, tags, ...props } = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li
  class="border-border flex gap-4 border-b py-6 last:border-b-0 lg:gap-5"
  {...itemAttrs}
>
  {
    coverImage && (
      <a href={postUrl} tabindex="-1" aria-hidden="true" class="shrink-0">
        <img
          src={coverImage}
          alt=""
          loading="lazy"
          width={192}
          height={120}
          class="border-border aspect-[8/5] w-32 rounded-md border object-cover lg:w-48"
        />
      </a>
    )
  }
  <div class="min-w-0 flex-1">
    <div
      class="flex flex-col gap-x-3 lg:flex-row lg:items-baseline lg:justify-between"
    >
      <a
        href={postUrl}
        class:list={[
          "text-foreground block min-w-0 text-lg font-semibold",
          "hover:text-accent focus-visible:text-accent transition-colors",
        ]}
      >
        <Heading transition:name={toTransitionName(id)} class="lg:truncate">
          {title}
        </Heading>
      </a>
      <Datetime {...props} class="shrink-0" />
    </div>
    <p class="text-muted-foreground mt-1 line-clamp-2">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-2 hidden flex-wrap gap-x-3 gap-y-1 lg:flex">
          {tags.map(tag => (
            <Tag tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }
  </div>
</li>
