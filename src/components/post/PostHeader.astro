---
import type { CollectionEntry } from "astro:content";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import EditPost from "@/components/post/EditPost.astro";
import { tplStr, useTranslations } from "@/i18n";
import { getReadingMinutes } from "@/utils/readingTime";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { title, pubDatetime, modDatetime, timezone, tags, hideEditPost } =
  post.data;

const t = useTranslations(Astro.currentLocale);
const readingTime = tplStr(t.post.readingTime, {
  minutes: getReadingMinutes(post.body),
});
const showEditPost = config.features.editPost?.enabled && !hideEditPost;
---

<header class="border-border border-b pb-6">
  <h1
    style={{ viewTransitionName: toTransitionName(post.id) }}
    class="text-foreground text-3xl leading-tight font-bold tracking-tight sm:text-4xl"
  >
    {title}
  </h1>

  <div
    class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1"
  >
    <Datetime {pubDatetime} {modDatetime} {timezone} />
    <span aria-hidden="true">·</span>
    <span class="text-sm">{readingTime}</span>
    {
      showEditPost && (
        <>
          <span aria-hidden="true" class="max-sm:hidden">
            ·
          </span>
          <EditPost {hideEditPost} {post} class="text-sm max-sm:hidden" />
        </>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {tags.map(tag => (
          <Tag tagName={tag} size="sm" />
        ))}
      </ul>
    )
  }
</header>
