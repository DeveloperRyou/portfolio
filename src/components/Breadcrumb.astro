---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getSubtopic, getTopic } from "@/taxonomy";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /topics/career/oasis => ['topics', 'career', 'oasis']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

// if breadcrumb is Home > Posts > [page] <etc>
// replace Posts with localized "Posts (page number)"
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(
    0,
    2,
    `${t.nav.posts} (${t.pagination.page.toLowerCase()} ${breadcrumbList[1] || 1})`
  );
}

type Crumb = { label: string; href?: string };

const pageSuffix = (page: string | undefined) =>
  page && page !== "1" ? ` (${t.pagination.page.toLowerCase()} ${page})` : "";

// Every other page: each segment links to its own top-level route.
let crumbs: Crumb[] = breadcrumbList.map((segment, index) => ({
  label: navLabels[segment] ?? decodeSegment(segment),
  href:
    index + 1 < breadcrumbList.length
      ? getRelativeLocaleUrl(locale, segment)
      : undefined,
}));

// Home > [topic] > [subtopic] (page n): there's no /topics/ index page, so
// the "topics" segment is dropped and slugs become their localized labels.
if (breadcrumbList[0] === "topics") {
  const [, topicSlug, second, third] = breadcrumbList;
  const topic = getTopic(topicSlug);
  const subtopic = second ? getSubtopic(topicSlug, second) : undefined;
  const page = subtopic ? third : second;
  const topicLabel = topic?.label ?? topicSlug;

  crumbs = subtopic
    ? [
        {
          label: topicLabel,
          href: getRelativeLocaleUrl(locale, `topics/${topicSlug}/`),
        },
        { label: subtopic.label + pageSuffix(page) },
      ]
    : [{ label: topicLabel + pageSuffix(page) }];
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
        {t.nav.home}
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      crumbs.map(({ label, href }) =>
        href ? (
          <li class="flex items-center gap-x-1">
            <a href={href} class="capitalize opacity-70">
              {label}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        ) : (
          <li>
            <span class="capitalize opacity-75" aria-current="page">
              {label}
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
