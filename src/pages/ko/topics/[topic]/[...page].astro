---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostList from "@/components/PostList.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostsByLocale } from "@/utils/postLocale";
import { getTopicTree } from "@/utils/getTopicTree";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const locale = "ko";
  const posts = getPostsByLocale(
    await getCollection("posts", ({ data }) => !data.draft),
    locale
  );

  return getTopicTree(posts).flatMap(topic => {
    const sorted = getSortedPosts(topic.posts);
    return paginate(sorted, {
      params: { topic: topic.slug },
      props: { label: topic.label, posts: sorted },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, label, posts } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${label} | ${config.site.title}`}>
  <Breadcrumb />

  <Main
    pageTitle={label}
    pageDesc={tplStr(t.pages.topicDesc, { topic: label })}
  >
    <PostList {posts} {page} />
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
