---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostList from "@/components/PostList.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getPostsByLocale } from "@/utils/postLocale";
import { getTopicTree } from "@/utils/getTopicTree";
import { compareSeriesOrder } from "@/utils/seriesOrder";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const locale = config.site.lang;
  const posts = getPostsByLocale(
    await getCollection("posts", ({ data }) => !data.draft),
    locale
  );

  return getTopicTree(posts).flatMap(topic =>
    topic.subtopics.flatMap(subtopic => {
      // A subtopic reads as a series: by `order`, then oldest first.
      const sorted = [...subtopic.posts].sort(compareSeriesOrder);
      return paginate(sorted, {
        params: { topic: topic.slug, subtopic: subtopic.slug },
        props: {
          topicLabel: topic.label,
          label: subtopic.label,
          posts: sorted,
        },
        pageSize: config.posts.perPage,
      });
    })
  );
}

const { page, topicLabel, label, posts } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${label} - ${topicLabel} | ${config.site.title}`}>
  <Breadcrumb />

  <Main
    pageTitle={label}
    pageDesc={tplStr(t.pages.topicDesc, { topic: label })}
  >
    <PostList {posts} {page} defaultSort="series" />
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
